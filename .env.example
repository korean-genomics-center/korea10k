# Site-specific filesystem locations for the Korea10K analysis scripts.
#
# Copy this file to `.env` in the repository root and set each root to the
# corresponding location on your machine.  `.env` is git-ignored, so real
# server paths never enter version control.
#
#     cp .env.example .env
#
# Only the roots used by the scripts you actually run need to be filled in;
# importing a name whose variable is unset raises a descriptive error.

# Personal analysis workspace holding the per-analysis working directories
# (admixture/, shapeit/, hla/, depthCoverage/, pca/, variant/, paper/, ...).
KOREA10K_WORK_DIR=/path/to/workspace

# Korea10K project root holding Resources/, Results/ and Analysis/.
KOREA10K_PROJECT_DIR=/path/to/Korea10KGenome

# Shared bioinformatics tool installations
# (plink2, shapeit5, admixture, minimac3/4, GLIMPSE2, gatk, ...).
KOREA10K_TOOL_DIR=/path/to/tools

# Shared reference genomes and liftover chain files
# (hg38.fa, hg19.fa, hg19ToHg38.over.chain.gz, ...).
KOREA10K_REF_DIR=/path/to/references

# Bulk storage for raw sequencing and per-sample intermediate data.
KOREA10K_STORE_DIR=/path/to/store

# Conda environment root providing the external binaries invoked by the
# pipeline scripts (tabix, bcftools, ...).
KOREA10K_CONDA_ENV_DIR=/path/to/miniconda3/envs

# KOREF personal multiomics reference project root.
KOREF_DIR=/path/to/KOREF_PersonalMultiomicsReference
